{
  "name": "png2font-api",
  "version": "1.0.0",
  "description": "Node.js font generation service. Orchestrates PNG-to-TTF pipeline via TypeScript, with external tools (FontForge, nanoemoji) as subprocesses.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "npm run css:watch & tsx watch src/server.ts",
    "build": "npm run css:build && tsc",
    "css:build": "tailwindcss -i ./static/tailwind.css -o ./static/style.css",
    "css:watch": "tailwindcss -i ./static/tailwind.css -o ./static/style.css --watch"
  },
  "dependencies": {
    "archiver": "^6.0.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "smol-toml": "^1.2.2",
    "which": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.17",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^3.12.7",
    "typescript": "^5.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "font-generation",
    "png-to-font",
    "ttf",
    "svg",
    "webfont"
  ],
  "author": "png2font contributors",
  "license": "Apache-2.0"
}
