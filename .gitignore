# Python project gitignore — ignore virtualenvs, caches, builds, IDE files, and generated artifacts

## Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

## C extensions
*.so

node_modules/

## Distribution / packaging
build/
dist/
*.egg-info/
pip-wheel-metadata/
*.egg
.eggs/

## Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
.pyenv/

## Installer logs
pip-log.txt
pip-delete-this-directory.txt

## Unit test / coverage
htmlcov/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover
.pytest_cache/

## Type checkers
.mypy_cache/

## IDE/editor directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

## OS files
.DS_Store
Thumbs.db

## Environment variables
.env
.env.*

## Local config override
config.local.toml

## Generated assets (SVGs, fonts, intermediate build output)
svg_glyphs/
renamed_svg_glyphs/
font2/
*.ttf
*.otf

glyphs*/

## Logs and temp
*.log
*.tmp
*~

## Jupyter
.ipynb_checkpoints
